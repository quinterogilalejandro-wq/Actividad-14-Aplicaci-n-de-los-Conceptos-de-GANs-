        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torchvision import datasets, transforms\n",
        "from torch.utils.data import DataLoader\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.gridspec as gridspec\n",
        "import numpy as np\n",
        "\n",
        "# ==========================================\n",
        "# 1. CONFIGURACIÓN Y HIPERPARÁMETROS\n",
        "# ==========================================\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print(f\"Dispositivo de entrenamiento: {device}\")\n",
        "\n",
        "lr = 0.0002\n",
        "batch_size = 64\n",
        "z_dim = 64          # Tamaño del vector de ruido (espacio latente)\n",
        "image_dim = 28 * 28 # MNIST: 28x28 píxeles = 784\n",
        "epochs = 20\n",
        "\n",
        "# ==========================================\n",
        "# 2. PREPARACIÓN DEL DATASET\n",
        "# ==========================================\n",
        "# Normalización al rango [-1, 1] para coincidir con la salida Tanh del generador\n",
        "transform = transforms.Compose([\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize((0.5,), (0.5,))\n",
        "])\n",
        "\n",
        "dataset = datasets.MNIST(root='./data', train=True, transform=transform, download=True)\n",
        "dataloader = DataLoader(dataset, batch_size=batch_size, shuffle=True, drop_last=True)\n",
        "\n",
        "# ==========================================\n",
        "# 3. ARQUITECTURA DE LA GAN\n",
        "# ==========================================\n",
        "\n",
        "class Generator(nn.Module):\n",
        "    \"\"\"\n",
        "    Componente encargado de mapear ruido aleatorio (espacio latente)\n",
        "    hacia el espacio de datos reales (creación de imágenes falsas).\n",
        "    \"\"\"\n",
        "    def __init__(self, z_dim, img_dim):\n",
        "        super(Generator, self).__init__()\n",
        "        self.gen = nn.Sequential(\n",
        "            nn.Linear(z_dim, 128),\n",
        "            nn.LeakyReLU(0.2),\n",
        "            nn.Linear(128, 256),\n",
        "            nn.LeakyReLU(0.2),\n",
        "            nn.Linear(256, 512),\n",
        "            nn.LeakyReLU(0.2),\n",
        "            nn.Linear(512, img_dim),\n",
        "            nn.Tanh()  # Salida en rango [-1, 1]\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.gen(x)\n",
        "\n",
        "\n",
        "class Discriminator(nn.Module):\n",
        "    \"\"\"\n",
        "    Clasificador binario encargado de evaluar si una imagen es real (1)\n",
        "    o falsa/generada (0).\n",
        "    \"\"\"\n",
        "    def __init__(self, img_dim):\n",
        "        super(Discriminator, self).__init__()\n",
        "        self.disc = nn.Sequential(\n",
        "            nn.Linear(img_dim, 512),\n",
        "            nn.LeakyReLU(0.2),\n",
        "            nn.Linear(512, 256),\n",
        "            nn.LeakyReLU(0.2),\n",
        "            nn.Linear(256, 1),\n",
        "            nn.Sigmoid()  # Salida en rango [0, 1] (probabilidad)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.disc(x)\n",
        "\n",
        "# Inicialización de modelos\n",
        "gen = Generator(z_dim, image_dim).to(device)\n",
        "disc = Discriminator(image_dim).to(device)\n",
        "\n",
        "# Configuraciones de optimización y pérdida\n",
        "criterion = nn.BCELoss()  # Pérdida de Entropía Cruzada Binaria\n",
        "opt_gen = optim.Adam(gen.parameters(), lr=lr)\n",
        "opt_disc = optim.Adam(disc.parameters(), lr=lr)\n",
        "\n",
        "# Vector de ruido fijo para evaluar la evolución visual del generador\n",
        "fixed_noise = torch.randn(16, z_dim).to(device)\n",
        "\n",
        "# ==========================================\n",
        "# 4. REGISTROS DE PÉRDIDA\n",
        "# ==========================================\n",
        "# Listas para almacenar la pérdida promedio por época\n",
        "losses_G = []   # Pérdida del Generador por época\n",
        "losses_D = []   # Pérdida del Discriminador por época\n",
        "\n",
        "# Instantáneas visuales cada 5 épocas para analizar evolución\n",
        "visual_snapshots = {}   # {epoca: tensor de imágenes generadas}\n",
        "\n",
        "# ==========================================\n",
        "# 5. BUCLE DE ENTRENAMIENTO ADVERSARIAL\n",
        "# ==========================================\n",
        "print(\"\\nIniciando entrenamiento adversarial...\")\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    epoch_loss_G = 0.0\n",
        "    epoch_loss_D = 0.0\n",
        "    num_batches = 0\n",
        "\n",
        "    for batch_idx, (real, _) in enumerate(dataloader):\n",
        "        # Aplanar imágenes reales de [batch_size, 1, 28, 28] a [batch_size, 784]\n",
        "        real = real.view(-1, 784).to(device)\n",
        "        curr_batch_size = real.shape[0]\n",
        "\n",
        "        # -----------------------------------------------------------------\n",
        "        # ENTRENAMIENTO DEL DISCRIMINADOR: Maximizar log(D(x)) + log(1 - D(G(z)))\n",
        "        # -----------------------------------------------------------------\n",
        "        disc.zero_grad()\n",
        "\n",
        "        # Pasar imágenes reales por el discriminador (etiqueta = 1)\n",
        "        labels_real = torch.ones(curr_batch_size, 1).to(device)\n",
        "        output_real = disc(real)\n",
        "        loss_disc_real = criterion(output_real, labels_real)\n",
        "\n",
        "        # Generar imágenes falsas a partir de ruido (etiqueta = 0)\n",
        "        noise = torch.randn(curr_batch_size, z_dim).to(device)\n",
        "        fake = gen(noise)\n",
        "        labels_fake = torch.zeros(curr_batch_size, 1).to(device)\n",
        "\n",
        "        # Detener gradientes del generador al evaluar en el discriminador\n",
        "        output_fake = disc(fake.detach())\n",
        "        loss_disc_fake = criterion(output_fake, labels_fake)\n",
        "\n",
        "        # Pérdida total del discriminador y retropropagación\n",
        "        loss_disc = loss_disc_real + loss_disc_fake\n",
        "        loss_disc.backward()\n",
        "        opt_disc.step()\n",
        "\n",
        "        # -----------------------------------------------------------------\n",
        "        # ENTRENAMIENTO DEL GENERADOR: Maximizar log(D(G(z)))\n",
        "        # -----------------------------------------------------------------\n",
        "        gen.zero_grad()\n",
        "\n",
        "        # El generador quiere que el discriminador clasifique las falsas como reales (1)\n",
        "        labels_for_gen = torch.ones(curr_batch_size, 1).to(device)\n",
        "        output_fake_for_gen = disc(fake)  # Aquí sí se calculan gradientes para el generador\n",
        "        loss_gen = criterion(output_fake_for_gen, labels_for_gen)\n",
        "\n",
        "        loss_gen.backward()\n",
        "        opt_gen.step()\n",
        "\n",
        "        # Acumular pérdidas para promediar por época\n",
        "        epoch_loss_G += loss_gen.item()\n",
        "        epoch_loss_D += loss_disc.item()\n",
        "        num_batches += 1\n",
        "\n",
        "    # Pérdida promedio de la época\n",
        "    avg_loss_G = epoch_loss_G / num_batches\n",
        "    avg_loss_D = epoch_loss_D / num_batches\n",
        "    losses_G.append(avg_loss_G)\n",
        "    losses_D.append(avg_loss_D)\n",
        "\n",
        "    # Captura visual cada 5 épocas y en la última\n",
        "    if (epoch + 1) % 5 == 0 or epoch == epochs - 1:\n",
        "        with torch.no_grad():\n",
        "            snap = gen(fixed_noise).cpu().view(-1, 28, 28)\n",
        "        visual_snapshots[epoch + 1] = snap\n",
        "\n",
        "    print(f\"Época [{epoch+1:02d}/{epochs}] | \"\n",
        "          f\"Pérdida D (avg): {avg_loss_D:.4f} | \"\n",
        "          f\"Pérdida G (avg): {avg_loss_G:.4f}\")\n",
        "\n",
        "# ==========================================\n",
        "# 6. VISUALIZACIÓN DE CURVAS DE PÉRDIDA\n",
        "# ==========================================\n",
        "fig, ax = plt.subplots(figsize=(9, 4))\n",
        "\n",
        "ax.plot(range(1, epochs + 1), losses_G, label='Pérdida Generador (G)',\n",
        "        color='#E74C3C', linewidth=2, marker='o', markersize=4)\n",
        "ax.plot(range(1, epochs + 1), losses_D, label='Pérdida Discriminador (D)',\n",
        "        color='#2980B9', linewidth=2, marker='s', markersize=4)\n",
        "\n",
        "ax.set_xlabel('Época', fontsize=12)\n",
        "ax.set_ylabel('Pérdida BCE (promedio por época)', fontsize=12)\n",
        "ax.set_title('Dinámica de entrenamiento adversarial — GAN en MNIST', fontsize=13, fontweight='bold')\n",
        "ax.legend(fontsize=11)\n",
        "ax.grid(True, linestyle='--', alpha=0.6)\n",
        "ax.set_xlim(1, epochs)\n",
        "\n",
        "# Anotar punto de menor pérdida del generador\n",
        "min_g_epoch = losses_G.index(min(losses_G)) + 1\n",
        "ax.annotate(f'Mín G: {min(losses_G):.3f}',\n",
        "            xy=(min_g_epoch, min(losses_G)),\n",
        "            xytext=(min_g_epoch + 1, min(losses_G) + 0.1),\n",
        "            arrowprops=dict(arrowstyle='->', color='#E74C3C'),\n",
        "            fontsize=9, color='#E74C3C')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('curvas_perdida_gan.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "print(\"→ Gráfica guardada como 'curvas_perdida_gan.png'\")\n",
        "\n",
        "# ==========================================\n",
        "# 7. VISUALIZACIÓN DE EVOLUCIÓN DEL GENERADOR\n",
        "# ==========================================\n",
        "snapshot_epochs = sorted(visual_snapshots.keys())\n",
        "n_snapshots = len(snapshot_epochs)\n",
        "\n",
        "fig = plt.figure(figsize=(4 * n_snapshots, 5))\n",
        "gs = gridspec.GridSpec(1, n_snapshots, figure=fig)\n",
        "\n",
        "for col, ep in enumerate(snapshot_epochs):\n",
        "    imgs = visual_snapshots[ep]\n",
        "    # Mini-grid 4x4 dentro de cada columna\n",
        "    inner = gridspec.GridSpecFromSubplotSpec(4, 4, subplot_spec=gs[col],\n",
        "                                             wspace=0.05, hspace=0.05)\n",
        "    for row in range(4):\n",
        "        for c in range(4):\n",
        "            ax = fig.add_subplot(inner[row, c])\n",
        "            idx = row * 4 + c\n",
        "            img = (imgs[idx].numpy() * 0.5) + 0.5  # Desnormalizar a [0,1]\n",
        "            ax.imshow(img, cmap='gray')\n",
        "            ax.axis('off')\n",
        "    # Título de columna\n",
        "    fig.text(\n",
        "        (col + 0.5) / n_snapshots, 0.97,\n",
        "        f'Época {ep}',\n",
        "        ha='center', va='top', fontsize=11, fontweight='bold'\n",
        "    )\n",
        "\n",
        "fig.suptitle('Evolución de imágenes generadas por época', y=1.02, fontsize=13, fontweight='bold')\n",
        "plt.tight_layout()\n",
        "plt.savefig('evolucion_generador_gan.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "print(\"→ Gráfica guardada como 'evolucion_generador_gan.png'\")\n",
        "\n",
        "# ==========================================\n",
        "# 8. VISUALIZACIÓN FINAL + ANÁLISIS IMPRESO\n",
        "# ==========================================\n",
        "with torch.no_grad():\n",
        "    generated_imgs = gen(fixed_noise).cpu().view(-1, 28, 28)\n",
        "\n",
        "fig, axes = plt.subplots(4, 4, figsize=(6, 6))\n",
        "for i, ax in enumerate(axes.flat):\n",
        "    img = (generated_imgs[i].numpy() * 0.5) + 0.5  # Desnormalizar a [0,1]\n",
        "    ax.imshow(img, cmap='gray')\n",
        "    ax.axis('off')\n",
        "\n",
        "plt.suptitle(f\"Imágenes generadas — Época {epochs}\", fontsize=12, fontweight='bold')\n",
        "plt.tight_layout()\n",
        "plt.savefig('imagenes_finales_gan.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "print(\"→ Gráfica guardada como 'imagenes_finales_gan.png'\")\n",
        "\n",
        "# ==========================================\n",
        "# 9. ANÁLISIS DE RESULTADOS\n",
        "# ==========================================\n",
        "loss_ratio_final = losses_G[-1] / losses_D[-1]\n",
        "g_trend = losses_G[-1] - losses_G[0]\n",
        "d_trend = losses_D[-1] - losses_D[0]\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"       ANÁLISIS DE RESULTADOS — GAN MNIST\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "print(f\"\"\"\n",
        "[1] CALIDAD DE LAS IMÁGENES GENERADAS\n",
        "  - La GAN entrenada con arquitectura completamente conectada\n",
        "    (FC-GAN) sobre MNIST produce dígitos reconocibles tras\n",
        "    {epochs} épocas de entrenamiento adversarial.\n",
        "  - Las imágenes presentan bordes difusos y cierta falta de\n",
        "    nitidez, característica esperada en redes densas (sin\n",
        "    convoluciones), que no modelan explícitamente la estructura\n",
        "    espacial local de los píxeles.\n",
        "  - Una DCGAN (con capas Conv2D / ConvTranspose2D) produciría\n",
        "    imágenes notablemente más nítidas y estructuradas.\n",
        "\n",
        "[2] DINÁMICA ADVERSARIAL (pérdidas por época)\n",
        "  - Pérdida G inicial:  {losses_G[0]:.4f}  →  Final: {losses_G[-1]:.4f}  (Δ {g_trend:+.4f})\n",
        "  - Pérdida D inicial:  {losses_D[0]:.4f}  →  Final: {losses_D[-1]:.4f}  (Δ {d_trend:+.4f})\n",
        "  - Ratio G/D final:    {loss_ratio_final:.4f}\n",
        "  - Un ratio G/D cercano a 1.0 indica un equilibrio relativo\n",
        "    entre ambos modelos (ninguno domina completamente al otro),\n",
        "    lo que es señal de un entrenamiento estable.\n",
        "\n",
        "\n",
        "\"\"\")\n",
        "print(\"=\"*60)"
